# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173
TZ=Asia/Kolkata

# --- Database (docker compose reads POSTGRES_*; DATABASE_URL must use the same user/password/db) ---
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=workforce
# Host port for the Docker database. Not 5432/5433 so it does not clash with other local PostgreSQL servers.
DB_PORT=5434
DATABASE_URL=postgresql://workforce:change-me-db@localhost:5434/workforce

# --- Auth (generate real values: openssl rand -hex 32) ---
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
FACE_ENCRYPTION_KEY=change-me-64-hex-chars

# --- Seed owner (used by pnpm db:seed) ---
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner
OWNER_PASSWORD=change-me-now

# --- Local LLM (Ollama on the GPU PC) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b            # fits a 6 GB GPU; check ollama.com/library, final model is chosen on the client's GPU
OLLAMA_NUM_CTX=4096               # keep small on 6 GB cards