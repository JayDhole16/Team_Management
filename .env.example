# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
APP_BASE_URL=http://localhost:5173
TZ=Asia/Kolkata

# --- Database (docker compose reads POSTGRES_*; DATABASE_URL must use the same user/password/db) ---
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=workforce
# Host port for the Docker database. Not 5432/5433 so it does not clash with other local PostgreSQL servers.
DB_PORT=5434
DATABASE_URL=postgresql://workforce:change-me-db@localhost:5434/workforce

# --- Auth (generate real values: openssl rand -hex 32) ---
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
# Keys the hash of access codes and registration tokens (only hashes are stored).
CODE_HASH_SECRET=change-me-code
FACE_ENCRYPTION_KEY=change-me-64-hex-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Registration / access codes ---
# Minutes an employee has to finish registering after entering a code (PRD Q11: 30).
REGISTRATION_WINDOW_MIN=30
# false until the real face scan exists (Phase 9 sets it to true).
FACE_ENROLLMENT_REQUIRED=false
# Wrong codes from ALL addresses in 15 min before code entry pauses and the owner is alerted.
CLAIM_GLOBAL_FAILURE_CAP=50
# true only behind a trusted proxy/tunnel (Phase 11), so rate limits see the real client IP.
TRUST_PROXY=false

# --- Work sessions ---
# Close a session at its last agent heartbeat when none arrives for this many seconds (PRD: 3 min).
SESSION_AUTOCLOSE_AFTER_SEC=180
# Close a session that never got an agent heartbeat this many hours after it started (flagged in reports).
SESSION_NO_HEARTBEAT_MAX_HOURS=12

# --- Seed owner (used by pnpm db:seed) ---
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner
OWNER_PASSWORD=change-me-now

# --- Local LLM (Ollama on the GPU PC) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b            # fits a 6 GB GPU; check ollama.com/library, final model is chosen on the client's GPU
OLLAMA_NUM_CTX=4096               # keep small on 6 GB cards