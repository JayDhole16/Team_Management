{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "e2e:serve": "tsx src/test/e2e-server.ts",
    "llm:eval": "tsx ../../scripts/llm-eval.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@lk/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
