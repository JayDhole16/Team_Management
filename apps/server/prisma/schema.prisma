// Data model: docs/ARCHITECTURE.md section 4. Tables use snake_case names.
// The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum DeviceMode {
  COMPANY_MACBOOK
  PERSONAL
}

enum CodePurpose {
  INVITE
  PASSWORD_RESET
  FACE_RESCAN
}

enum SessionEndReason {
  MANUAL_STOP
  AUTO_CLOSED
  LOGOUT
  DEACTIVATED
  /// A session that never got an agent heartbeat, closed after SESSION_NO_HEARTBEAT_MAX_HOURS.
  MAX_DURATION
}

enum HeartbeatState {
  ACTIVE
  IDLE
  AWAY
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskSource {
  /// From the AI breakdown of a project brief (possibly edited by the owner).
  AI_BREAKDOWN
  /// Typed by the owner inside a project (e.g. while the AI was offline).
  MANUAL
  /// Direct task to one employee, no project.
  DIRECT
}

enum CodeStatus {
  ACTIVE
  CLAIMED
  USED
  EXPIRED
  REVOKED
}

model User {
  id                    String      @id @default(uuid()) @db.Uuid
  /// Always stored lowercased (emails compare case-insensitively).
  email                 String      @unique
  name                  String
  phone                 String?
  emergencyContactName  String?     @map("emergency_contact_name")
  emergencyContactPhone String?     @map("emergency_contact_phone")
  /// Calendar date in Asia/Kolkata. Owner-only field.
  joiningDate           DateTime    @map("joining_date") @db.Date
  passwordHash          String      @map("password_hash")
  role                  UserRole
  status                UserStatus  @default(ACTIVE)
  jobRoleId             String?     @map("job_role_id") @db.Uuid
  /// Owner-only. Null for the owner account.
  deviceMode            DeviceMode? @map("device_mode")
  idleIntervalMin       Int         @default(20) @map("idle_interval_min")
  /// AES-256-GCM encrypted (iv | tag | ciphertext). Never logged, never returned.
  faceTemplate          Bytes?      @map("face_template")
  faceModelVersion      String?     @map("face_model_version")
  faceEnrolledAt        DateTime?   @map("face_enrolled_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  deactivatedAt         DateTime?   @map("deactivated_at")

  jobRole         JobRole?          @relation(fields: [jobRoleId], references: [id])
  devices         Device[]
  refreshTokens   RefreshToken[]
  consentRecords  ConsentRecord[]
  codesCreated    AccessCode[]      @relation("CodeCreatedBy")
  codesTargeted   AccessCode[]      @relation("CodeTarget")
  codesRegistered AccessCode[]      @relation("CodeRegistered")
  auditEntries    AuditLog[]
  workSessions    WorkSession[]
  heartbeats      Heartbeat[]
  projectsCreated Project[]         @relation("ProjectCreatedBy")
  tasksAssigned   Task[]            @relation("TaskAssignee")
  tasksCreated    Task[]            @relation("TaskCreatedBy")
  taskEvents      TaskStatusEvent[]

  @@index([role, status])
  @@map("users")
}

model JobRole {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  label String

  users       User[]
  presetCodes AccessCode[]
  tasks       Task[]

  @@map("job_roles")
}

model Device {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  os           String
  hostname     String
  agentVersion String     @map("agent_version")
  mode         DeviceMode
  lastSeenAt   DateTime?  @map("last_seen_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  workSessions WorkSession[]

  @@index([userId])
  @@map("devices")
}

model AccessCode {
  id               String      @id @default(uuid()) @db.Uuid
  purpose          CodePurpose
  /// HMAC-SHA256 of the normalized code (keyed with CODE_HASH_SECRET). The code itself is never stored.
  codeHash         String      @unique @map("code_hash")
  createdById      String      @map("created_by") @db.Uuid
  /// PASSWORD_RESET / FACE_RESCAN: the employee the code is for.
  targetUserId     String?     @map("target_user_id") @db.Uuid
  presetJobRoleId  String?     @map("preset_job_role_id") @db.Uuid
  /// INVITE only. Chosen by the owner; the employee can never change it.
  deviceMode       DeviceMode? @map("device_mode")
  note             String?
  expiresAt        DateTime    @map("expires_at")
  status           CodeStatus  @default(ACTIVE)
  claimedAt        DateTime?   @map("claimed_at")
  /// HMAC-SHA256 of the registration token handed out at claim.
  claimTokenHash   String?     @unique @map("claim_token_hash")
  claimExpiresAt   DateTime?   @map("claim_expires_at")
  usedAt           DateTime?   @map("used_at")
  /// The user created by this INVITE (makes /register/complete idempotent).
  registeredUserId String?     @unique @map("registered_user_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")

  createdBy      User     @relation("CodeCreatedBy", fields: [createdById], references: [id])
  targetUser     User?    @relation("CodeTarget", fields: [targetUserId], references: [id])
  registeredUser User?    @relation("CodeRegistered", fields: [registeredUserId], references: [id])
  presetJobRole  JobRole? @relation(fields: [presetJobRoleId], references: [id])

  @@index([status, expiresAt])
  @@map("access_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// HMAC-SHA256 of the token (keyed with REFRESH_TOKEN_SECRET).
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model ConsentRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  consentVersion String   @map("consent_version")
  acceptedAt     DateTime @map("accepted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("consent_records")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  meta        Json     @default("{}")
  at          DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_log")
}

model WorkSession {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  deviceId        String?           @map("device_id") @db.Uuid
  startedAt       DateTime          @map("started_at")
  endedAt         DateTime?         @map("ended_at")
  endReason       SessionEndReason? @map("end_reason")
  /// Newest heartbeat attached to this session (denormalised for the auto-close job).
  lastHeartbeatAt DateTime?         @map("last_heartbeat_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  user       User             @relation(fields: [userId], references: [id])
  device     Device?          @relation(fields: [deviceId], references: [id])
  heartbeats Heartbeat[]
  gaps       WorkSessionGap[]

  /// At most one open session per user, enforced by the database.
  @@unique([userId], map: "work_sessions_one_open_per_user", where: raw("ended_at IS NULL"))
  @@index([userId, startedAt])
  @@index([endedAt, lastHeartbeatAt])
  @@map("work_sessions")
}

/// Agent heartbeat. Kept 90 days.
model Heartbeat {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  sessionId  String         @map("session_id") @db.Uuid
  /// Client time (may be back-dated up to 12 h when the agent replays its offline queue).
  at         DateTime
  state      HeartbeatState
  receivedAt DateTime       @map("received_at")

  user    User        @relation(fields: [userId], references: [id])
  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, at])
  @@index([at])
  @@map("heartbeats")
}

/// A stretch of a session known only from replayed (back-dated) heartbeats. Flagged in reports.
model WorkSessionGap {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  fromAt    DateTime @map("from_at")
  toAt      DateTime @map("to_at")
  createdAt DateTime @default(now()) @map("created_at")

  session WorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("work_session_gaps")
}

model Project {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  /// The owner's own words (often Hinglish). Null for a project typed by hand without a brief.
  briefOriginal    String?  @map("brief_original")
  /// Sent to employees together with each task.
  summaryTechnical String   @map("summary_technical")
  createdById      String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  createdBy User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  tasks     Task[]

  @@index([createdAt])
  @@map("projects")
}

model Task {
  id                   String       @id @default(uuid()) @db.Uuid
  /// Null for a direct task.
  projectId            String?      @map("project_id") @db.Uuid
  title                String
  descriptionTechnical String       @map("description_technical")
  /// The owner's plain wording of a direct task. Owner-only.
  descriptionOriginal  String?      @map("description_original")
  jobRoleId            String?      @map("job_role_id") @db.Uuid
  /// Null until the owner sends the task.
  assigneeId           String?      @map("assignee_id") @db.Uuid
  status               TaskStatus   @default(PENDING)
  priority             TaskPriority
  source               TaskSource
  /// Set while the task is BLOCKED.
  blockedReason        String?      @map("blocked_reason")
  createdById          String       @map("created_by") @db.Uuid
  assignedAt           DateTime?    @map("assigned_at")
  completedAt          DateTime?    @map("completed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  project   Project?          @relation(fields: [projectId], references: [id])
  jobRole   JobRole?          @relation(fields: [jobRoleId], references: [id])
  assignee  User?             @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  events    TaskStatusEvent[]

  @@index([assigneeId, status])
  @@index([projectId])
  @@map("tasks")
}

/// Every status change (and every (re)assignment) of a task.
model TaskStatusEvent {
  id         String      @id @default(uuid()) @db.Uuid
  taskId     String      @map("task_id") @db.Uuid
  /// Null on the first assignment.
  fromStatus TaskStatus? @map("from_status")
  toStatus   TaskStatus  @map("to_status")
  byUserId   String      @map("by_user_id") @db.Uuid
  /// The blocked reason, or "Reassigned".
  note       String?
  at         DateTime

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  byUser User @relation(fields: [byUserId], references: [id])

  @@index([taskId, at])
  @@map("task_status_events")
}
